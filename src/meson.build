driver_sources = files(
  'driver.c',
  'diag.c',
  'api.c',
  'handles.c',
  'context.c',
  'convert.c',
  'decode.c',
  'surface.c',
  'buffer.c',
  'image.c',
  'codec_mpeg2.c',
  'codec_h264.c',
  'codec_hevc.c',
  'hevc_trace.c',
  'codec_vp8.c',
  'codec_vp9.c',
  'codec_av1.c',
)

shared_module('v4l2_request_drv_video',
              driver_sources,
              name_prefix: '',
              include_directories: root_inc,
              c_args: ['-fvisibility=hidden'],
              dependencies: [libva_dep, libdrm_dep, threads_dep],
              install: true,
              install_dir: driverdir)
